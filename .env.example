# Most local defaults are already built in. Set only the values you need to override.
# APP_NAME=猜拳挑戰
# PORT=3000
# API_BASE_URL=http://localhost:3000
# PUBLIC_BASE_URL=http://localhost:5173
# ALLOWED_ORIGIN=http://localhost:5173
# DATABASE_PATH=./data/game.sqlite

# Required only when enabling LIFF login.
LIFF_ID=

# Optional public feature switches
LIFF_ENABLED=false
CAMERA_ENABLED=true
CAMERA_FALLBACK_ENABLED=true
MGM_ENABLED=false
LEADERBOARD_ENABLED=true
EMAIL_ENABLED=false
RULE_VERSION=v1
ASSET_VERSION=v1

# Server-only secrets: never expose these through Vite or /api/config.
# Fill these only for the integrations you enable.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
RESEND_API_KEY=
RESEND_FROM=
